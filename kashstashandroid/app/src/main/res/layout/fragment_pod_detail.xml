<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#111314"
            app:titleTextColor="#FFFFFF"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:navigationIcon="?attr/homeAsUpIndicator"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Filters Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111314"
                android:padding="16dp"
                android:elevation="4dp">

                <!-- Date Range Picker -->
                <LinearLayout
                    android:id="@+id/dateRangeButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#222227"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📅  Date Range: Last 30 Days"
                        android:textSize="16sp"
                        android:textColor="#007AFF"/>
                </LinearLayout>

                <!-- Sort Picker -->
                <LinearLayout
                    android:id="@+id/sortButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#222227"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⬇️  Sort: Newest First"
                        android:textSize="16sp"
                        android:textColor="#007AFF"/>
                </LinearLayout>

                <!-- Tag Filter -->
                <LinearLayout
                    android:id="@+id/tagFilterButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#222227"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🏷️  Filter by Tags"
                        android:textSize="16sp"
                        android:textColor="#007AFF"/>
                </LinearLayout>

                <!-- Search Bar -->
                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="#222227"
                    android:hint="🔍 Search digests..."
                    android:textColorHint="#999999"
                    android:textColor="#FFFFFF"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="text"/>

            </LinearLayout>

            <!-- Digest Count -->
            <TextView
                android:id="@+id/digestCountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="152 DIGESTS (165 TOTAL)"
                android:textSize="12sp"
                android:textColor="#999999"
                android:fontFamily="sans-serif-medium"
                android:padding="16dp"/>

            <!-- RecyclerView for Digests -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/digestsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button for New Post -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/newPostFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#007AFF"
        app:tint="#FFFFFF"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>