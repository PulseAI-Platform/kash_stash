<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#111314">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upload Destination"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="20dp" />

    <RadioGroup
        android:id="@+id/destinationRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/radioEndpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Endpoint Only (AI Processing)"
            android:textColor="#FFFFFF"
            android:buttonTint="#FFFFFF"
            android:padding="12dp" />

        <RadioButton
            android:id="@+id/radioKashFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kash Files Only (Link + Caption)"
            android:textColor="#FFFFFF"
            android:buttonTint="#FFFFFF"
            android:padding="12dp" />

        <RadioButton
            android:id="@+id/radioBoth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Both (File to Kash Files + Link Digest to Endpoint)"
            android:textColor="#FFFFFF"
            android:buttonTint="#FFFFFF"
            android:padding="12dp" />

    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnCancelDestination"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:backgroundTint="#222227"
            android:textColor="#999999"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirmDestination"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Continue"
            android:backgroundTint="#FFFFFF"
            android:textColor="#111314"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>