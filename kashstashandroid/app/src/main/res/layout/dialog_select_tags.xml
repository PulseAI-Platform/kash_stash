<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#111314">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Tags"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recent tags (tap to use):"
        android:textSize="14sp"
        android:textColor="#CCCCCC"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/recentTagsList"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="16dp"
        android:background="#222227"
        android:padding="8dp"
        android:divider="#333333"
        android:dividerHeight="1dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Or enter new tags:"
        android:textSize="14sp"
        android:textColor="#CCCCCC"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/tagInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tags (comma separated)"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:backgroundTint="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:backgroundTint="#222227"
            android:textColor="#999999"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/submitButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OK"
            android:backgroundTint="#FFFFFF"
            android:textColor="#111314"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>