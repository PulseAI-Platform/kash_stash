<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#111314"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Pod Badge + Author -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/podBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="pod-name"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="#007AFF"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/youBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="#34C759"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/digestTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Digest Title"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:paddingBottom="8dp"/>

        <!-- Content Preview -->
        <TextView
            android:id="@+id/digestContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Content of the digest goes here..."
            android:textSize="14sp"
            android:textColor="#CCCCCC"
            android:maxLines="4"
            android:ellipsize="end"
            android:paddingBottom="12dp"/>

        <!-- Link Preview Container -->
        <LinearLayout
            android:id="@+id/linkPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A007AFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/linkPreviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Link Title"
                android:textSize="14sp"
                android:textColor="#007AFF"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/linkPreviewDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="12sp"
                android:textColor="#CCCCCC"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/linkPreviewUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="website.com"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Tags -->
        <TextView
            android:id="@+id/digestTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="#tag1 #tag2 #tag3"
            android:textSize="12sp"
            android:textColor="#007AFF"
            android:paddingBottom="12dp"/>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/replyButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="↩️ Reply"
                android:backgroundTint="#222227"
                android:textColor="#007AFF"
                android:textSize="11sp"
                android:minWidth="72dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/threadButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="💬 1 reply"
                android:backgroundTint="#222227"
                android:textColor="#BB86FC"
                android:textSize="11sp"
                android:minWidth="80dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/shareButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🔗 Share"
                android:backgroundTint="#222227"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:minWidth="72dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today at 10:21 PM"
                android:textSize="11sp"
                android:textColor="#666666"
                android:gravity="end"/>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>