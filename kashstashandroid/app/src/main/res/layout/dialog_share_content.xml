<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#111314">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Share to Kash Stash"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp" />

    <!-- Shared Content Preview (for links/text) -->
    <TextView
        android:id="@+id/sharedContentPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="#1A1A1A"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- Caption Input -->
    <EditText
        android:id="@+id/captionInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Caption (optional)"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:backgroundTint="#FFFFFF"
        android:minHeight="48dp"
        android:layout_marginBottom="16dp" />

    <!-- Tags Display/Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/selectedTagsDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tags: (none)"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSelectTags"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Select Tags"
            android:backgroundTint="#222227"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:backgroundTint="#222227"
            android:textColor="#999999"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirmShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Upload"
            android:backgroundTint="#FFFFFF"
            android:textColor="#111314"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>