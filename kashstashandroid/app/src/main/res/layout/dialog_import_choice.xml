<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#111314">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Import Configuration"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnImportEndpointQr"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Import Endpoint from QR"
        android:backgroundTint="#222227"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnImportKashFilesQr"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Import Kash Files from QR"
        android:backgroundTint="#222227"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnManualEntry"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Manual Configuration"
        android:backgroundTint="#222227"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:backgroundTint="@android:color/transparent"
        android:textColor="#999999" />

</LinearLayout>